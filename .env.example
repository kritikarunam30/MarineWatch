# Copy to .env and fill in. Never commit .env.

# fixture | live | replay
DATA_MODE=fixture
# mumbai_high | kg_basin
BASIN_ID=mumbai_high
REPLAY_INCIDENT=

DATA_DIR=./data
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/monitor
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor

CORS_ORIGINS=http://localhost:5173

# Earth Engine (non-commercial Google Cloud project)
EE_PROJECT=
# Global Fishing Watch API key (attribution required)
GFW_API_TOKEN=
# Copernicus Marine
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Earth Observation Group (VIIRS Nightfire)
EOG_USERNAME=
EOG_PASSWORD=

# Frontend
VITE_API_URL=http://localhost:8000
